{
  "description": "C-Stack default Poteto activation with session opt-out.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/cstack-mode.mjs\"",
            "timeout": 2,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/cstack-mode.mjs\"",
            "timeout": 2,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/cstack-mode.mjs\"",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^pstack-poteto-agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/poteto-subagent-context.mjs\"",
            "timeout": 2,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
